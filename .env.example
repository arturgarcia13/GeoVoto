# Banco de dados (Supabase Postgres + PostGIS)
POSTGRES_URL=
POSTGRES_SSLMODE=require

# SMTP para envio do magic link
MAIL_SENDER_EMAIL=
MAIL_SENDER_PASSWORD=
MAIL_SENDER_NAME=Administração GeoVoto
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465

# URL pública usada no link do e-mail (sem barra no fim)
APP_PUBLIC_URL=http://localhost:8501

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
